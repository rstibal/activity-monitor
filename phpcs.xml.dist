<?xml version="1.0"?>
<ruleset name="Activity Monitor">
	<description>
		WordPress-Extra (security/correctness) plus PHPCompatibilityWP against
		the project's 7.4 floor. Excludes are formatting/doc-block sniffs this
		codebase has never conformed to and would take a wholesale reformat to
		satisfy -- see CLAUDE.md's Verifying section. They are style-only,
		never correctness or security.
	</description>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<file>.</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>

	<config name="minimum_supported_wp_version" value="5.3"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress-Extra">
		<!-- Doc-block requirements: this codebase uses narrative class/method
		     comments, not WPCS's structured @param/@package format. -->
		<exclude name="Squiz.Commenting"/>
		<exclude name="Generic.Commenting.DocComment"/>

		<!-- Whitespace/formatting-only: tabs vs spaces, comma spacing, array
		     alignment, multi-line call layout, CRLF line endings, embedded
		     PHP tag spacing. None of these change behavior. -->
		<exclude name="Generic.Files.LineEndings"/>
		<exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
		<exclude name="Generic.WhiteSpace.ScopeIndent"/>
		<exclude name="Universal.WhiteSpace.PrecisionAlignment"/>
		<exclude name="Universal.WhiteSpace.CommaSpacing"/>
		<exclude name="WordPress.Arrays.MultipleStatementAlignment"/>
		<exclude name="WordPress.Arrays.ArrayDeclarationSpacing"/>
		<exclude name="WordPress.WhiteSpace.OperatorSpacing"/>
		<exclude name="PEAR.Functions.FunctionCallSignature"/>
		<exclude name="Generic.Formatting.MultipleStatementAlignment"/>
		<exclude name="Generic.Formatting.DisallowMultipleStatements"/>
		<exclude name="Generic.Functions.FunctionCallArgumentSpacing"/>
		<exclude name="Generic.ControlStructures.InlineControlStructure"/>
		<exclude name="Squiz.PHP.EmbeddedPhp"/>
		<exclude name="PSR2.ControlStructures.SwitchDeclaration"/>
		<exclude name="NormalizedArrays.Arrays.ArrayBraceSpacing"/>
		<exclude name="Generic.Strings.UnnecessaryStringConcat"/>
		<exclude name="Squiz.PHP.DisallowSizeFunctionsInLoops"/>

		<!-- Style preferences the codebase deliberately doesn't follow. -->
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<exclude name="Universal.Operators.DisallowStandalonePostIncrementDecrement"/>
		<exclude name="WordPress.PHP.YodaConditions"/>

		<!-- This plugin's entire job is querying its own custom tables via
		     $wpdb; there is no object-cache layer for am_events/am_event_context,
		     and none is planned. See CLAUDE.md architecture. -->
		<exclude name="WordPress.DB.DirectDatabaseQuery"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="activity-monitor"/>
			</property>
		</properties>
	</rule>
</ruleset>
